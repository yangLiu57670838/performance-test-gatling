# Every setting can be passed as a CLI parameter (key=value) or as an env var.
# CLI parameters take precedence. Export these in your shell or CI; they are not auto-loaded.

# Which targets to hit (comma separated, see src/config/targets.ts)
TARGETS=local

# Load profile: smoke | load | stress | spike | soak
PROFILE=smoke
USERS=1
DURATION=60
RAMP_DURATION=30
THINK_TIME=1

# Assertion thresholds
P95=1000
P99=2000
MAX_ERROR_PERCENT=1

# Per-target base URL overrides: <TARGET>_BASE_URL
# LOCAL_BASE_URL=http://localhost:4000
# JSONPLACEHOLDER_BASE_URL=https://staging.example.com

# Per-target bearer tokens: <TARGET>_TOKEN
# LOCAL_TOKEN=changeme
